# 复制为仓库根目录的 .env 后再填写真实值。
# .env 已被 .gitignore 忽略，不要提交。

# 邮件发送（注册/找回密码验证码）
SEND_MAIL=
MAIL_KEY=

# 和风天气
WEATHER_API_KEY=
WEATHER_HOST=
WEATHER_PROJECT=
WEATHER_JWT_KEY=
WEATHER_PRIVATE_KEY=

# AI 助手（Spring AI / MaxKB）
MAXKB_API_KEY=
DEEPSEEK_API_KEY=

# 数据库（示例值，按自己的环境改）
DB_USERNAME=root
DB_PASSWORD=

# JWT 签名密钥（随机字符串，建议 32 位以上）
JWT_KEY=

# MinIO 对象存储
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
